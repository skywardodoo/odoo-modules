<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_oauth_client_list" model="ir.ui.view">
		<field name="name">skyward_mcp_oauth.client.list</field>
		<field name="model">skyward_mcp_oauth.client</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="client_id"/>
				<field name="is_public"/>
				<field name="allow_write"/>
				<field name="dynamic"/>
				<field name="active" column_invisible="True"/>
			</list>
		</field>
	</record>

	<record id="view_oauth_client_form" model="ir.ui.view">
		<field name="name">skyward_mcp_oauth.client.form</field>
		<field name="model">skyward_mcp_oauth.client</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button
						name="action_generate_secret"
						type="object"
						string="Generate Secret"
						invisible="is_public or not id"
					/>
				</header>
				<sheet>
					<widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
					<group>
						<group>
							<field name="name"/>
							<field name="client_id"/>
							<field name="is_public"/>
							<field name="allow_write"/>
							<field name="dynamic"/>
							<field name="active" invisible="True"/>
						</group>
						<group>
							<field name="redirect_uris" placeholder="https://claude.ai/api/mcp/auth_callback"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_oauth_client" model="ir.actions.act_window">
		<field name="name">OAuth Clients</field>
		<field name="res_model">skyward_mcp_oauth.client</field>
		<field name="view_mode">list,form</field>
	</record>

</odoo>
