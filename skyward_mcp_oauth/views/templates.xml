<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<template id="consent" name="MCP OAuth Consent">
		<t t-call="web.login_layout">
			<t t-set="disable_database_manager" t-value="True"/>
			<form class="oe_login_form" method="post" action="/mcp/oauth/authorize" role="form">
				<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
				<t t-foreach="fields.items()" t-as="field">
					<input type="hidden" t-att-name="field[0]" t-att-value="field[1]"/>
				</t>

				<div class="mb-3">
					<label class="form-label">Connect to MCP</label>
					<p class="mb-0">
						<strong class="text-primary" t-out="client.name"/> wants to access this database as
						<strong class="text-primary" t-out="user.name"/>.
					</p>
				</div>

				<div class="mb-3" t-if="offers_write">
					<label class="form-label">Permissions</label>
					<div class="form-check">
						<input class="form-check-input" type="checkbox" id="grant_read" checked="checked" disabled="disabled"/>
						<label class="form-check-label" for="grant_read">Read the data you can access</label>
					</div>
					<div class="form-check">
						<input class="form-check-input" type="checkbox" id="grant_write" name="grant_write" value="1"/>
						<label class="form-check-label" for="grant_write">Create and change data</label>
					</div>
				</div>

				<div class="oe_login_buttons text-center gap-1 d-grid mb-1 pt-3">
					<button type="submit" name="decision" value="approve" class="btn btn-primary">Allow</button>
					<button type="submit" name="decision" value="deny" class="btn btn-link btn-sm">Deny</button>
				</div>
			</form>
		</t>
	</template>

	<template id="error" name="MCP OAuth Error">
		<t t-call="web.login_layout">
			<t t-set="disable_database_manager" t-value="True"/>
			<div class="oe_login_form">
				<div class="mb-3">
					<h5 class="mb-3">Cannot connect</h5>
					<p class="alert alert-danger mb-0" role="alert" t-out="description or error"/>
				</div>
			</div>
		</t>
	</template>

</odoo>
